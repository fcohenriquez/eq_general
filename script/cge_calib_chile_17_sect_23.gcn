##################################
# MEGC-Chile 17 sectores, SAM 2023, con margen de comercio separado.
# Desagregacion respecto de la estructura base: la mineria se separa en cobre y
# resto (con petroleo crudo como producto propio); la manufactura se separa en
# bebidas alcoholicas, bebidas no alcoholicas, tabaco, combustibles (diesel,
# gasolinas y otros combustibles) y resto de la manufactura.
#
# Margen de comercio (cuenta Margen_com de la SAM). El servicio de comercio que
# presta Act_com_hot_rest se registra como un servicio propio y no como produccion
# de los bienes que comercializa (Lofgren, Harris y Robinson, 2002; Decaluwe et
# al., 2013):
#  - Oferta: Act_com_hot_rest produce el servicio de margen con la participacion
#    mshare_mg (cero en las demas actividades), a precio pmg.
#  - Demanda: cada unidad fisica de un producto requiere mu_i unidades de margen en
#    el uso intermedio, mu_f en la demanda final (hogares, gobierno, inversion) y
#    mu_e en las exportaciones (cuadros 24 y 25 de los COU 2023 del BCCh).
#  - Precios: pq  = (p + mu_f*pmg + tau_e*IPC) * (1 + t_iva + t_adic)
#             pint = (p + mu_i*pmg) * (1 + t_iva_int) + kappa_e*tau_e*IPC
#             pe   = pworlde*exr - mu_e*pmg   (precio productor de las exportaciones)
#    La base del IVA incluye el margen, como en el precio de comprador de las
#    cuentas nacionales (oferta a precio de usuario = precio productor + margen + IVA).
#  - Las existencias no pagan margen (cero en el cuadro 25).
#  - pworlde > 1 en la base: las exportaciones se miden a valor productor (FOB menos
#    margen), de modo que pe = 1 en la base y el valor FOB es pworlde*exr*EX.
#
# Cierre macro:
#  - Numerario: IPC (CPI[] = cpi_num). El sistema es homogeneo de grado cero en
#    precios: todo parametro nominal esta indexado a CPI (o a exr si es externo).
#  - Inversion determinada por el ahorro: inv_adj se ajusta para que S = I.
#  - Ahorro externo fijo en moneda extranjera: SAVext = SAVext_target * exr.
#  - Prestaciones sociales: lo que pagan empresas y gobierno es lo que reciben
#    los hogares (PSh endogeno), de modo que la ley de Walras se cumple.
#  - Las ofertas de factores responden al retorno real NETO de impuestos directos:
#    el trabajo, al salario neto de PIT; el capital, al retorno neto del IDPC
#    (capital de empresas) y del PIT (capital de hogares).
#  - Base del PIT: ingreso de los hogares antes de impuestos (BTINC) menos las
#    transferencias del gobierno (TRGOV), que no tributan.
# Consumo de los hogares: utilidad CES anidada en forma de participaciones
# calibradas (Rutherford, 1995). El nivel superior (sigma_sup) combina tres
# compuestos: tabaco (nido de un solo bien), combustibles (nido Pcomb, sigma_comb)
# y resto del consumo (nido Presto, omega). Los parametros th son participaciones
# en el gasto de la base y dst las cantidades de la base, de modo que el equilibrio
# base reproduce la SAM para cualquier valor de las elasticidades.
# Impuestos sobre productos (cunas de precio):
#  - IVA (t_iva) e impuesto adicional ad valorem a bebidas (t_adic, misma base que
#    el IVA) sobre la demanda final.
#  - Impuestos especificos por unidad fisica (tau_e), indexados al IPC: los paga la
#    demanda final y, con el factor kappa_e, el uso intermedio. kappa_e = 0 en los
#    productos cuyo uso intermedio no paga el impuesto (tabaco); kappa_e = 1 si lo
#    paga integro (gasolinas); 0 < kappa_e < 1 si una parte se recupera (diesel:
#    credito especial y recuperacion del transporte de carga).
#  - Los especificos que gravan las importaciones de tabaco y combustibles se
#    registran en la cuenta de especificos de la SAM, no en la de aranceles.
# Sector externo e instituciones (SAM 2023 conciliada con las cuentas por sector
# institucional, la balanza de pagos y la recaudacion del SII):
#  - Las empresas reciben la renta de la inversion directa en el exterior (YROWF),
#    fija en moneda extranjera.
#  - Las rentas que distribuyen las empresas (a hogares TREMP, al gobierno TRFG y al
#    resto del mundo ROWF) son proporciones del ingreso de las empresas neto del
#    IDPC (BASEF) cuando sw_dist = 1, o del ingreso bruto cuando sw_dist = 0.
#  - El Impuesto Adicional de la LIR (TIA) grava las rentas pagadas al resto del
#    mundo con una tasa efectiva t_ia; lo paga el resto del mundo y forma parte de
#    Tax. (TADIC es el impuesto adicional a bebidas, distinto del anterior.)
#  - Los hogares remesan al exterior una proporcion de su ingreso disponible (REMH).
#  - Una fraccion de las remuneraciones se paga a no residentes (par_l_out); los
#    hogares reciben la fraccion par_l_h.
#  - RNROW resume los pagos netos de ingreso primario y secundario al resto del
#    mundo; la balanza de pagos (ley de Walras) es SAVext = M - X + RNROW, con X a
#    valor FOB (pworlde*exr*EX).
#
# Cierres alternativos (bloque CIERRE). Los valores por defecto de los
# interruptores reproducen el cierre descrito arriba:
#  - sw_joh = 0: inversion determinada por el ahorro (s_adj = 1, inv_adj endogeno).
#    sw_joh = 1: cierre de Johansen (inv_adj = 1; la propension al ahorro de los
#    hogares se ajusta mediante s_adj).
#  - sw_g = sw_tr = 0: tasas, gasto y transferencias reales fijos; ahorro publico
#    residual (g_adj = tr_adj = 1).
#    sw_g = 1: ahorro publico real fijo en SAVg_target; el consumo del gobierno en
#    volumen se ajusta mediante g_adj.
#    sw_tr = 1: ahorro publico real fijo en SAVg_target; las transferencias reales
#    a hogares se ajustan mediante tr_adj.
#  - sw_g y sw_tr no pueden valer 1 simultaneamente (sistema singular).
#  - SAVg_target debe fijarse en el ahorro publico real del equilibrio base antes
#    de activar sw_g o sw_tr (eval_cierres_17_sect_23.Rmd).
##################################



indexsets
{
  LAB = {'Trabajo_1', 'Trabajo_2', 'Trabajo_3'};

  P    = {'prod_Agri', 'prod_Cobre', 'prod_Crudo', 'prod_Min_resto', 'prod_Beb_alc',
           'prod_Beb_noalc', 'prod_Tabaco', 'prod_Diesel', 'prod_Gasolinas',
           'prod_Otros_comb', 'prod_Manu_resto', 'prod_elect_agua_gas', 'prod_const',
           'prod_com_hot_rest', 'prod_trans_comu_inf', 'prod_int_fin', 'prod_inmo_viv',
           'prod_serv_emp', 'prod_serv_pers', 'prod_adm_pub', 'prod_otros'};

  Pdom = {'prod_Agri', 'prod_Cobre', 'prod_Crudo', 'prod_Min_resto', 'prod_Beb_alc',
           'prod_Beb_noalc', 'prod_Tabaco', 'prod_Diesel', 'prod_Gasolinas',
           'prod_Otros_comb', 'prod_Manu_resto', 'prod_elect_agua_gas', 'prod_const',
           'prod_com_hot_rest', 'prod_trans_comu_inf', 'prod_int_fin', 'prod_inmo_viv',
           'prod_serv_emp', 'prod_serv_pers', 'prod_adm_pub'};

  # Pdom_arm: productos con importaciones > 0 (excluye prod_adm_pub, cero estructural en M)
  Pdom_arm = {'prod_Agri', 'prod_Cobre', 'prod_Crudo', 'prod_Min_resto', 'prod_Beb_alc',
              'prod_Beb_noalc', 'prod_Tabaco', 'prod_Diesel', 'prod_Gasolinas',
              'prod_Otros_comb', 'prod_Manu_resto', 'prod_elect_agua_gas', 'prod_const',
              'prod_com_hot_rest', 'prod_trans_comu_inf', 'prod_int_fin', 'prod_inmo_viv',
              'prod_serv_emp', 'prod_serv_pers'};

  Pno_const = {'prod_Agri', 'prod_Cobre', 'prod_Crudo', 'prod_Min_resto', 'prod_Beb_alc',
               'prod_Beb_noalc', 'prod_Tabaco', 'prod_Diesel', 'prod_Gasolinas',
               'prod_Otros_comb', 'prod_Manu_resto', 'prod_elect_agua_gas',
               'prod_com_hot_rest', 'prod_trans_comu_inf', 'prod_int_fin', 'prod_inmo_viv',
               'prod_serv_emp', 'prod_serv_pers', 'prod_adm_pub', 'prod_otros'};

  # Pcon: productos en la utilidad de los hogares (excluye cobre, crudo, resto de la
  # mineria y construccion, sin consumo de hogares en la SAM)
  Pcon  = {'prod_Agri', 'prod_Beb_alc', 'prod_Beb_noalc', 'prod_Tabaco', 'prod_Diesel',
            'prod_Gasolinas', 'prod_Otros_comb', 'prod_Manu_resto', 'prod_elect_agua_gas',
            'prod_com_hot_rest', 'prod_trans_comu_inf', 'prod_int_fin', 'prod_inmo_viv',
            'prod_serv_emp', 'prod_serv_pers', 'prod_adm_pub', 'prod_otros'};

  # Nidos de la utilidad CES anidada. Pcon = {prod_Tabaco} + Pcomb + Presto.
  Pcomb  = {'prod_Diesel', 'prod_Gasolinas', 'prod_Otros_comb'};

  Presto = {'prod_Agri', 'prod_Beb_alc', 'prod_Beb_noalc', 'prod_Manu_resto',
            'prod_elect_agua_gas', 'prod_com_hot_rest', 'prod_trans_comu_inf',
            'prod_int_fin', 'prod_inmo_viv', 'prod_serv_emp', 'prod_serv_pers',
            'prod_adm_pub', 'prod_otros'};

  P_Exp  = {'prod_Agri', 'prod_Cobre', 'prod_Crudo', 'prod_Min_resto', 'prod_Beb_alc',
             'prod_Beb_noalc', 'prod_Tabaco', 'prod_Diesel', 'prod_Gasolinas',
             'prod_Otros_comb', 'prod_Manu_resto', 'prod_elect_agua_gas',
             'prod_com_hot_rest', 'prod_trans_comu_inf', 'prod_int_fin',
             'prod_inmo_viv', 'prod_serv_emp', 'prod_serv_pers'};

  P_NExp = {'prod_const', 'prod_adm_pub'};

  SA = {'Act_Agri', 'Act_Cobre', 'Act_Min_resto', 'Act_Beb_alc', 'Act_Beb_noalc',
        'Act_Tabaco', 'Act_Combustibles', 'Act_Manu_resto', 'Act_elect_agua_gas',
        'Act_com_hot_rest', 'Act_trans_comu_inf', 'Act_int_fin', 'Act_serv_emp',
        'Act_serv_pers', 'Act_adm_pub'};

  SB = {'Act_const', 'Act_inmo_viv'};

  S  = {'Act_Agri', 'Act_Cobre', 'Act_Min_resto', 'Act_Beb_alc', 'Act_Beb_noalc',
         'Act_Tabaco', 'Act_Combustibles', 'Act_Manu_resto', 'Act_elect_agua_gas',
         'Act_const', 'Act_com_hot_rest', 'Act_trans_comu_inf', 'Act_int_fin',
         'Act_inmo_viv', 'Act_serv_emp', 'Act_serv_pers', 'Act_adm_pub'};

  PMinP = {'prod_Cobre', 'prod_Crudo', 'prod_Min_resto', 'prod_Beb_alc', 'prod_Beb_noalc',
           'prod_Tabaco', 'prod_Diesel', 'prod_Gasolinas', 'prod_Otros_comb',
           'prod_Manu_resto', 'prod_elect_agua_gas', 'prod_com_hot_rest',
           'prod_trans_comu_inf', 'prod_int_fin', 'prod_inmo_viv',
           'prod_serv_emp', 'prod_serv_pers'};

  # PdomNoC: productos domesticos salvo construccion (usados como insumo por SA y SB)
  PdomNoC = {'prod_Agri', 'prod_Cobre', 'prod_Crudo', 'prod_Min_resto', 'prod_Beb_alc',
             'prod_Beb_noalc', 'prod_Tabaco', 'prod_Diesel', 'prod_Gasolinas',
             'prod_Otros_comb', 'prod_Manu_resto', 'prod_elect_agua_gas',
             'prod_com_hot_rest', 'prod_trans_comu_inf', 'prod_int_fin',
             'prod_inmo_viv', 'prod_serv_emp', 'prod_serv_pers', 'prod_adm_pub'};
};


block CONSUMER
{
    controls
    {
        <idx_d::Pcon> D<idx_d>[];
    };

    objective
    {
        # CES anidada en forma de participaciones calibradas. En la base, cada
        # cociente D/dst vale 1 y U = u_bar (gasto de consumo de la base).
        #   nivel superior : sigma_sup  (tabaco, combustibles, resto)
        #   combustibles   : sigma_comb (diesel, gasolinas, otros combustibles)
        #   resto          : omega
        U[] = u_bar * ( th_tab * (D<'prod_Tabaco'>[] / dst<'prod_Tabaco'>)^((sigma_sup - 1.0)/sigma_sup)
                      + th_comb * (SUM<ic::Pcomb>(th<ic> * (D<ic>[] / dst<ic>)^((sigma_comb - 1.0)/sigma_comb)))^(((sigma_sup - 1.0)/sigma_sup) / ((sigma_comb - 1.0)/sigma_comb))
                      + th_resto * (SUM<ir::Presto>(th<ir> * (D<ir>[] / dst<ir>)^((omega - 1.0)/omega)))^(((sigma_sup - 1.0)/sigma_sup) / ((omega - 1.0)/omega))
                      )^(sigma_sup/(sigma_sup - 1.0));
    };

    constraints
    {
        SUM<idx_i_1::Pcon>(pq<idx_i_1>[] * D<idx_i_1>[]) + SAV[] + CS[] + REMH[] = INC[];
    };

    identities
    {
        INC[] = BTINC[] - PITAX[];
        BTINC[] = pk[] * Kh[] + SUM<l::LAB>(w<l>[] * Lh<l>[]) + TRGOV[] + TREMP[] + PSh[] + fact_row_in_k_data + fact_row_in_l_data;
        # s_adj = 1 salvo en el cierre de Johansen (sw_joh = 1)
        SAV[] = INC[] * por_sav * s_adj[];
        CS[] = INC[] * por_cont;
        # Remesas de los hogares al resto del mundo: proporcion del ingreso disponible
        REMH[] = INC[] * por_rem;
        # Productos sin consumo de hogares en la SAM (conjunto PNC del YAML)
        D<'prod_Cobre'>[]     = dst_nc<'prod_Cobre'>;
        D<'prod_Crudo'>[]     = dst_nc<'prod_Crudo'>;
        D<'prod_Min_resto'>[] = dst_nc<'prod_Min_resto'>;
        D<'prod_const'>[]     = dst_nc<'prod_const'>;
    };
};

# Actividades. El ingreso incluye el servicio de margen de comercio (pmg *
# mshare_mg), que solo produce Act_com_hot_rest (mshare_mg = 0 en las demas).
block <sa::SA> SECTORS_A {
  controls { V<sa>[], K<sa>[],  <l::LAB> L<sa,l>[]; };
  objective {
    pi<sa>[] = V<sa>[]*(SUM<p::Pdom>(pz<p>[]*make_share<p,sa>) + pmg[]*mshare_mg<sa>)*(1-tps<sa>-tes<sa>)
              - K<sa>[]*pk[] - SUM<l::LAB>(L<sa,l>[] * w<l>[])
              - SUM<p_no_c::Pno_const>(io<p_no_c,sa>*V<sa>[]*pint<p_no_c>[]);
  };
  constraints { V<sa>[] = gamma<sa>*(K<sa>[]^betak<sa>)*PROD<l::LAB>(L<sa,l>[]^betal<sa,l>); };
  identities {
    <p_dom::Pdom> Yap<p_dom,sa>[] = V<sa>[]*make_share<p_dom,sa>;
    revenue<sa>[]     = SUM<p_rev::Pdom>(Yap<p_rev,sa>[]*pz<p_rev>[]) + V<sa>[]*mshare_mg<sa>*pmg[];
    net_revenue<sa>[] = revenue<sa>[]*(1-tps<sa>-tes<sa>);
    <p_no_cx::Pno_const> X<p_no_cx,sa>[] = io<p_no_cx,sa>*V<sa>[];
    va_nom<sa>[] = net_revenue<sa>[] - SUM<p_no_cv::Pno_const>(io<p_no_cv,sa>*V<sa>[]*pint<p_no_cv>[]);
  };
  calibration {
    V<sa>[] = vst<sa> -> gamma<sa>;
    K<sa>[]*pk[] = va_nom<sa>[]*betak<sa> -> betak<sa>;
   <l::LAB> L<sa,l>[] * w<l>[] = va_nom<sa>[] * betal<sa,l> -> betal<sa,l>;
  };
};

block <sb::SB> SECTORS_B {
  controls { V<sb>[], K<sb>[],  <l::LAB> L<sb,l>[]; };
  objective {
    pi<sb>[] = V<sb>[]*(SUM<p::Pdom>(pz<p>[]*make_share<p,sb>) + pmg[]*mshare_mg<sb>)*(1-tps<sb>-tes<sb>)
              - K<sb>[]*pk[] - SUM<l::LAB>(L<sb,l>[] * w<l>[])
              - SUM<p_full::P>(io<p_full,sb>*V<sb>[]*pint<p_full>[]);
  };
  constraints { V<sb>[] = gamma<sb>*(K<sb>[]^betak<sb>)*PROD<l::LAB>(L<sb,l>[]^betal<sb,l>); };
  identities {
    <p_dom::Pdom> Yap<p_dom,sb>[] = V<sb>[]*make_share<p_dom,sb>;
    revenue<sb>[]     = SUM<p_rev::Pdom>(Yap<p_rev,sb>[]*pz<p_rev>[]) + V<sb>[]*mshare_mg<sb>*pmg[];
    net_revenue<sb>[] = revenue<sb>[]*(1-tps<sb>-tes<sb>);
    <p_fullx::P> X<p_fullx,sb>[] = io<p_fullx,sb>*V<sb>[];
    va_nom<sb>[] = net_revenue<sb>[] - SUM<p_fullv::P>(io<p_fullv,sb>*V<sb>[]*pint<p_fullv>[]);
  };
  calibration {
    V<sb>[] = vst<sb> -> gamma<sb>;
    K<sb>[]*pk[] = va_nom<sb>[]*betak<sb> -> betak<sb>;
    <l::LAB> L<sb,l>[] * w<l>[] = va_nom<sb>[] * betal<sb,l> -> betal<sb,l>;
  };
};

block <idx_e::P_Exp> EXPORTER
{
    controls
    {
        Z<idx_e>[], DS<idx_e>[], EX<idx_e>[];
    };

    objective
    {
        PI_CET<idx_e>[] = pe<idx_e>[] * EX<idx_e>[] + pd<idx_e>[] * DS<idx_e>[] - pz<idx_e>[] * Z<idx_e>[];
    };

    constraints
    {
        ( Z<idx_e>[] - at<idx_e> * ( gamma_e<idx_e> * EX<idx_e>[] ^ ((sigma_t + 1) / sigma_t) + (1.0 - gamma_e<idx_e>) * DS<idx_e>[] ^ ((sigma_t + 1) / sigma_t) ) ^ (sigma_t / (sigma_t + 1)) ) / Z0<idx_e> = 0.0;
    };

    identities
    {
        Z<idx_e>[] = SUM<i_sa::SA>(Yap<idx_e, i_sa>[]) + SUM<i_sb::SB>(Yap<idx_e, i_sb>[]);
        # Precio productor de las exportaciones: FOB menos el margen de comercio
        pe<idx_e>[] = pworlde<idx_e> * exr[] - mu_e<idx_e> * pmg[];
    };
};

block <idx_ne::P_NExp> NON_EXPORTER
{
    identities
    {
        Z<idx_ne>[] = SUM<i_sa::SA>(Yap<idx_ne, i_sa>[]) + SUM<i_sb::SB>(Yap<idx_ne, i_sb>[]);
        DS<idx_ne>[] = Z<idx_ne>[];
        EX<idx_ne>[] = 0.0;
        pe<idx_ne>[] = pworlde<idx_ne> * exr[];
        pz<idx_ne>[] = pd<idx_ne>[];
        PI_CET<idx_ne>[] = 0.0;
    };
};

block PROD_OTROS {
  identities {
    Z<'prod_otros'>[]    = 0.0;
    DS<'prod_otros'>[]   = 0.0;
    EX<'prod_otros'>[]   = ex_otros_data;
    DD<'prod_otros'>[]   = 0.0;
    PI_CET<'prod_otros'>[] = 0.0;
    PI_ARM<'prod_otros'>[] = 0.0;
    pe<'prod_otros'>[]   = pworlde<'prod_otros'> * exr[];
    pm<'prod_otros'>[]   = pworldm<'prod_otros'> * exr[] * (1.0 + tar_rate<'prod_otros'>);
    pz<'prod_otros'>[]   = pm<'prod_otros'>[];
    pd<'prod_otros'>[]   = pm<'prod_otros'>[];
    p<'prod_otros'>[]    = pm<'prod_otros'>[];
    pq<'prod_otros'>[]   = p<'prod_otros'>[];     # sin IVA ni margen
    pint<'prod_otros'>[] = p<'prod_otros'>[];
    Q<'prod_otros'>[]    = M<'prod_otros'>[];
    M<'prod_otros'>[]    = D<'prod_otros'>[] + gg_market_data_p<'prod_otros'> * g_adj[]
                          + (I_data<'prod_otros'> * inv_adj[]) + vexist<'prod_otros'>
                          + SUM<i_aa_o::SA>(X<'prod_otros', i_aa_o>[]) + SUM<i_ab_o::SB>(X<'prod_otros', i_ab_o>[])
                          + EX<'prod_otros'>[];
    VAT_p<'prod_otros'>[]       = 0.0;
    Arancel_p<'prod_otros'>[]   = tar_rate<'prod_otros'> * pworldm<'prod_otros'> * exr[] * M<'prod_otros'>[];
    # prod_otros no paga IVA, impuesto adicional, especificos ni margen (t_adic, tau_e,
    # kappa_e, mu_i y mu_f se definen solo sobre Pdom)
  };
};

block <idx_a::Pdom_arm> IMPORTER
{
    controls
    {
        Q<idx_a>[], DD<idx_a>[], M<idx_a>[];
    };

    objective
    {
        PI_ARM<idx_a>[] = p<idx_a>[] * Q<idx_a>[] - pd<idx_a>[] * DD<idx_a>[] - pm<idx_a>[] * M<idx_a>[];
    };

    constraints
    {
        Q<idx_a>[] = aq<idx_a> * ( delta_m<idx_a> * M<idx_a>[] ^ ((sigma_q - 1.0) / sigma_q) + (1.0 - delta_m<idx_a>) * DD<idx_a>[] ^ ((sigma_q - 1.0) / sigma_q) ) ^ (sigma_q / (sigma_q - 1.0));
    };

    identities
    {
        DD<idx_a>[] = DS<idx_a>[];
        pm<idx_a>[] = pworldm<idx_a> * exr[] * (1.0 + tar_rate<idx_a>);
    };
};

# Cero estructural: prod_adm_pub tiene M_base = 0 en la SAM.
# Se excluye de IMPORTER (cuya FOC genera M^(-0.5) -> Inf).
# Se reemplazan todos los controles y objetivo por identidades puras.
block PROD_ADM_PUB_ARM
{
    identities
    {
        DD<'prod_adm_pub'>[]     = DS<'prod_adm_pub'>[];
        M<'prod_adm_pub'>[]      = 0.0;
        Q<'prod_adm_pub'>[]      = DD<'prod_adm_pub'>[];
        PI_ARM<'prod_adm_pub'>[] = 0.0;
        pm<'prod_adm_pub'>[]     = pworldm<'prod_adm_pub'> * exr[] * (1.0 + tar_rate<'prod_adm_pub'>);
        p<'prod_adm_pub'>[]      = pd<'prod_adm_pub'>[];
    };
};

block PRODUCTS
{
    identities
    {
        # --- Margen de comercio, IVA, impuesto adicional y especificos como cunas de precio ---
        # p   : precio del compuesto Armington (basico + arancel), sin margen.
        # pq  : precio de comprador de la demanda final (hogares, gobierno, inversion).
        #       Incluye el margen de comercio (mu_f * pmg), el especifico por unidad
        #       fisica (tau_e), el IVA (t_iva) y el impuesto adicional ad valorem a
        #       bebidas (t_adic); ambos ad valorem se calculan sobre el precio con margen
        #       y especifico (misma base imponible).
        # pint: precio de los insumos intermedios. Incluye el margen del uso intermedio
        #       (mu_i * pmg) y la parte del especifico que paga el uso intermedio
        #       (kappa_e * tau_e); no paga impuesto adicional, y t_iva_int = 0 salvo
        #       residuo de calibracion.
        #       tau_e esta en pesos base por unidad fisica y se indexa al IPC (UTM).
        <pq_i::Pdom> pq<pq_i>[]   = (p<pq_i>[] + mu_f<pq_i> * pmg[] + tau_e<pq_i> * CPI[]) * (1 + t_iva<pq_i> + t_adic<pq_i>);
        <pi_i::Pdom> pint<pi_i>[] = (p<pi_i>[] + mu_i<pi_i> * pmg[]) * (1 + t_iva_int<pi_i>) + kappa_e<pi_i> * tau_e<pi_i> * CPI[];

        # Demanda final gravada e intermedia, en unidades fisicas (precio basico base)
        # g_adj = 1 salvo en el cierre fiscal con gasto endogeno (sw_g = 1)
        <fd_i::Pdom> FD<fd_i>[] = D<fd_i>[] + gg_market_data_p<fd_i> * g_adj[] + (I_data<fd_i> * inv_adj[]);
        <xi_i::PdomNoC> XI<xi_i>[] = SUM<i_aa_x::SA>(X<xi_i, i_aa_x>[]) + SUM<i_ab_x::SB>(X<xi_i, i_ab_x>[]);
        XI<'prod_const'>[] = SUM<i_ab_xc::SB>(X<'prod_const', i_ab_xc>[]);

        <td_i::Pdom> TD_Dom<td_i>[] = FD<td_i>[] + vexist<td_i> + XI<td_i>[];

        # Vaciado fisico: ni el margen, ni el IVA, ni los especificos absorben cantidades
        <qc_i::Pdom> Q<qc_i>[] = TD_Dom<qc_i>[];

        # Recaudacion IVA: demanda final a precio con margen y especifico; intermedios a
        # precio con margen
        <vt_i::Pdom> VAT_p<vt_i>[] = t_iva<vt_i> * (p<vt_i>[] + mu_f<vt_i> * pmg[] + tau_e<vt_i> * CPI[]) * FD<vt_i>[]
                                   + t_iva_int<vt_i> * (p<vt_i>[] + mu_i<vt_i> * pmg[]) * XI<vt_i>[];

        # Recaudacion del impuesto adicional ad valorem (IABA y bebidas analcoholicas):
        # misma base que el IVA de la demanda final
        <ta_i::Pdom> TADIC_p<ta_i>[] = t_adic<ta_i> * (p<ta_i>[] + mu_f<ta_i> * pmg[] + tau_e<ta_i> * CPI[]) * FD<ta_i>[];

        # Recaudacion de especificos: monto real fijo por unidad fisica de demanda final
        # y, con el factor kappa_e, de uso intermedio (indexado al IPC; la recaudacion
        # real sigue a los volumenes)
        <te_i::Pdom> TESP_p<te_i>[] = tau_e<te_i> * CPI[] * (FD<te_i>[] + kappa_e<te_i> * XI<te_i>[]);

        <idx_ar::Pdom> Arancel_p<idx_ar>[] = tar_rate<idx_ar> * pworldm<idx_ar> * exr[] * M<idx_ar>[];
    };
};

block MARGEN
{
    identities
    {
        # Demanda de servicio de margen: coeficientes fijos por unidad fisica de uso
        # intermedio, de demanda final y de exportaciones (Lofgren et al., 2002)
        QMG[] = SUM<mg_c::Pdom>(mu_i<mg_c> * XI<mg_c>[] + mu_f<mg_c> * FD<mg_c>[])
              + SUM<mg_e::P_Exp>(mu_e<mg_e> * EX<mg_e>[]);

        # Vaciado del mercado del servicio de margen: determina pmg
        SUM<mg_sa::SA>(V<mg_sa>[] * mshare_mg<mg_sa>) + SUM<mg_sb::SB>(V<mg_sb>[] * mshare_mg<mg_sb>) = QMG[];
    };
};

block FIRM
{
    identities
    {
        # Ingreso de las empresas: renta del capital, contribuciones recibidas y renta
        # de la inversion directa en el exterior (fija en moneda extranjera)
        INGF[] = Kf[] * pk[] + CS[] * por_cont_soc_f + YROWF[];
        YROWF[] = yrowf_data * exr[];
        # Base de las rentas distribuidas: ingreso neto del IDPC (sw_dist = 1) o bruto (sw_dist = 0)
        BASEF[] = INGF[] - sw_dist * FIRMTAX[];
        TREMP[] = BASEF[] * por_tremp;
        TRFG[]  = BASEF[] * por_tr_f_g;
        ROWF[]  = BASEF[] * por_rowf;
        SAVf[] = INGF[] - TREMP[] - TRFG[] - ROWF[] - INGF[] * por_pres_soc_f - FIRMTAX[];
        Kf[] = KD[] * par_k_f;
        FIRMTAX[] = fit * (Kf[] * pk[]);
    };
};

block GOB
{
    identities
    {
        INGG[] = Kg[] * pk[] + CS[] * por_cont_soc_g + Tax[] + TRFG[];
        # tr_adj = 1 salvo en el cierre fiscal con transferencias endogenas (sw_tr = 1)
        TRGOV[] = trgov_data * CPI[] * tr_adj[];
        SAVg[] = INGG[] - (SUM<idx_p::P>(gg_market_data_p<idx_p> * g_adj[] * pq<idx_p>[]) + TRGOV[] + INGG[] * por_pres_soc_g);
        Kg[] = KD[] * par_k_g;
        VAT[] = SUM<idx_v::P>(VAT_p<idx_v>[]);
        TADIC[] = SUM<idx_ta::Pdom>(TADIC_p<idx_ta>[]);
        # Base del PIT: rentas del capital y del trabajo de los hogares, transferencias de
        # empresas y prestaciones sociales. Las transferencias del gobierno (TRGOV) forman
        # parte del ingreso (BTINC) pero no de la base imponible.
        PITAX[] = pit * (pk[] * Kh[] + SUM<l::LAB>(w<l>[] * Lh<l>[]) + TREMP[] + PSh[] + fact_row_in_k_data + fact_row_in_l_data);
        TPROD[] = SUM<idx_sa::SA>(tps<idx_sa> * revenue<idx_sa>[]) +
                  SUM<idx_sb::SB>(tps<idx_sb> * revenue<idx_sb>[]);
        TESP[] = SUM<te_p::Pdom>(TESP_p<te_p>[]) +
                 SUM<idx_sa2::SA>(tes<idx_sa2> * revenue<idx_sa2>[]) +
                 SUM<idx_sb2::SB>(tes<idx_sb2> * revenue<idx_sb2>[]);
        TARANCEL[] = SUM<idx_p2::P>(Arancel_p<idx_p2>[]);
        # Impuesto Adicional de la LIR: tasa efectiva sobre las rentas pagadas al resto del mundo
        TIA[] = t_ia * ROWF[];
        Tax[] = VAT[] + TADIC[] + PITAX[] + FIRMTAX[] + TPROD[] + TESP[] + TARANCEL[] + TIA[];
    };
};

block EQUILIBRIUM
{
    identities
    {
       <l::LAB> LD<l>[] = SUM<idx_ea::SA>(L<idx_ea,l>[])
                 + SUM<idx_eb::SB>(L<idx_eb,l>[])
                 + l_total_data<l> * par_l_row<l>;

       <l::LAB> LFORCE<l>[] = l_force_data<l> * (LD<l>[] / l_total_data<l>)^epsilon<l>;

       # Curva salarial en terminos reales y netos de PIT: el salario real neto
       # w*(1-pit)/CPI depende del empleo. Se normaliza por la tasa de la base para
       # que la calibracion no cambie (w = 1 en la base).
       <l::LAB> w<l>[] * (1 - pit) / (1 - pit_base) = CPI[] * w_pot_calib<l> * (LD<l>[] / LFORCE<l>[])^phi<l>;

       <l::LAB> u_rate<l>[] = (LFORCE<l>[] - LD<l>[]) / LFORCE<l>[];

       <l::LAB> Lh<l>[] = LD<l>[] * par_l_h<l>;

       # Remuneraciones pagadas a no residentes
       LROWP[] = SUM<l_o::LAB>(w<l_o>[] * LD<l_o>[] * par_l_out<l_o>);

        KD[]  = SUM<idx_ka::SA>(K<idx_ka>[]) + SUM<idx_kb::SB>(K<idx_kb>[]);

        u_k[] = KD[] / k_total_data;

        # Curva de oferta de capital (utilizacion) en terminos reales y netos de
        # impuestos directos. Tasa efectiva sobre la renta del capital: IDPC sobre el
        # capital de empresas y PIT sobre el capital de hogares (el del gobierno no
        # tributa). Normalizada por la tasa de la base (pk = 1 en la base).
        pk[] * (1 - par_k_f * fit - par_k_h * pit) / (1 - par_k_f * fit_base - par_k_h * pit_base)
              = CPI[] * pk_pot_calib * (u_k[])^psi;

        Kh[]  = KD[] * par_k_h;

        # Prestaciones sociales: los hogares reciben lo que pagan empresas y gobierno
        PSh[] = INGF[] * por_pres_soc_f + INGG[] * por_pres_soc_g;

        # Indice de precios al consumidor (Laspeyres, canasta de hogares de la base)
        # y numerario
        CPI[] = SUM<c_cpi::Pcon>(cpi_q<c_cpi> * pq<c_cpi>[]) / cpi_den;
        CPI[] = cpi_num;
    }
}

block INVESTMENT
{
    identities
    {
        NOM_I_BASE[] = SUM<idx_nb::P>(I_data<idx_nb> * pq<idx_nb>[]);

        # Equilibrio ahorro-inversion. Con sw_joh = 0, inv_adj (indice de volumen de
        # la inversion, base = 1) se ajusta para que la inversion iguale al ahorro
        # total; con sw_joh = 1 se ajusta el ahorro de los hogares (bloque CIERRE).
        # Las existencias no pagan margen: se valoran a p.
        TOTAL_INVEST[] = NOM_I_BASE[] * inv_adj[] + SUM<p_v::P>(vexist<p_v> * p<p_v>[]);

        # Ahorro externo fijo en moneda extranjera
        SAVext[] = SAVext_target * exr[];

        # Pagos netos de ingreso primario y secundario al resto del mundo. La balanza
        # de pagos (implicada por la ley de Walras) es SAVext = M - X + RNROW.
        RNROW[] = ROWF[] + LROWP[] + REMH[] - TIA[] - YROWF[];

        SAV[] + SAVf[] + SAVg[] + SAVext[] = TOTAL_INVEST[];
    };
}

block CIERRE
{
    identities
    {
        # Regla ahorro-inversion: con sw_joh = 0 se fija s_adj = 1 (inversion
        # determinada por el ahorro); con sw_joh = 1 se fija inv_adj = 1 (Johansen).
        (1 - sw_joh) * (s_adj[] - 1) + sw_joh * (inv_adj[] - 1) = 0;

        # Regla fiscal: con sw_g = 0 (sw_tr = 0) se fija g_adj = 1 (tr_adj = 1); con
        # sw_g = 1 (sw_tr = 1) se fija el ahorro publico real y g_adj (tr_adj) se ajusta.
        (1 - sw_g)  * (g_adj[]  - 1) + sw_g  * (SAVg[] - SAVg_target * CPI[]) = 0;
        (1 - sw_tr) * (tr_adj[] - 1) + sw_tr * (SAVg[] - SAVg_target * CPI[]) = 0;
    };

    calibration
    {
        # Valores por defecto: cierre vigente. SAVg_target solo opera si sw_g = 1 o
        # sw_tr = 1 y debe fijarse en el ahorro publico real de la base.
        sw_joh = 0;
        sw_g = 0;
        sw_tr = 0;
        SAVg_target = 0;
    };
}
